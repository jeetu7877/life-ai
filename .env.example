# ==========================================
# Jeet Personal AI Companion - Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Jeet Personal AI Companion"
DEBUG=True

# Database Configuration
# Use PostgreSQL in production or local development:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/jeet_db"
# Or SQLite fallback for zero-dependency instant startup:
DATABASE_URL="sqlite:///./jeet.db"

# Security & Authentication
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_minimum_32_chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Sensitive Data Vault Key (Fernet 32-byte base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="replace_with_fernet_base64_encryption_key_here"

# Google Gemini API
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# ChromaDB Vector Database
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# File Uploads
UPLOAD_DIRECTORY="./uploads"
MAX_UPLOAD_SIZE_MB=25

# Voice & Wake Word
WAKE_WORD="Jeet"
DEFAULT_TIMEZONE="Asia/Kolkata"
SILENCE_TIMEOUT_SECONDS=7
