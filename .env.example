# ==========================================
# Jeet Personal AI Companion - Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Life Personal AI Companion"
DEBUG=True

# Database Configuration
DATABASE_URL="sqlite:///./jeet.db"

# Security & Authentication
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_minimum_32_chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Sensitive Data Vault Key (Fernet 32-byte base64 key)
ENCRYPTION_KEY="replace_with_fernet_base64_encryption_key_here"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# ChromaDB Vector Database
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# File Uploads
UPLOAD_DIRECTORY="./uploads"
MAX_UPLOAD_SIZE_MB=25

# Voice & Wake Word
WAKE_WORD="Life"
DEFAULT_TIMEZONE="Asia/Kolkata"
SILENCE_TIMEOUT_SECONDS=7

# Music & YouTube API (Optional: Get free key from Google Cloud Console for YouTube Data API v3)
YOUTUBE_API_KEY=""

